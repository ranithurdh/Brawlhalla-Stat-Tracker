# Copy this file to ".env" and fill it in.

PORT=3001

# >>> PASTE YOUR MONGODB CONNECTION STRING HERE <<<
# Free MongoDB Atlas example (replace USER and PASSWORD, keep the database name
# "brawlhalla-tracker" before the "?"):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/brawlhalla-tracker?retryWrites=true&w=majority
# Local MongoDB instead:
MONGODB_URI=mongodb://127.0.0.1:27017/brawlhalla-tracker

# Optional: default Gemini key. You can also paste a key on the Settings page,
# which takes priority over this one.
GEMINI_API_KEY=

# REQUIRED: the admin password. Only an admin can edit what Gemini read before
# submitting, edit or delete a saved match, open Settings and edit players.
# Anyone can still upload a screenshot and submit what Gemini read.
# Pick something long. If this is empty, all admin actions are locked.
ADMIN_PASSWORD=

# Strongly recommended on a public site: a short secret word that dorm members
# enter once (on the Add match page) before they can upload screenshots. Without it,
# anyone with the link can use up your Gemini quota. Admins never need it.
UPLOAD_CODE=

# Optional: screenshot reads allowed per connection every 15 minutes (default 40).
# A whole dorm may share one internet address, so keep this fairly generous.
# UPLOAD_LIMIT_PER_15_MIN=40

# Optional: a separate key for signing Gemini results (defaults to the admin password).
DRAFT_SECRET=

# Only needed if the React app is hosted on a different address than this server
# (several addresses can be separated by commas). Not needed when this server
# serves the site itself (see "Deploy" in the README).
CLIENT_ORIGIN=http://localhost:5173
